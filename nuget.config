<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Clears machine/user-level fallback package folders. A machine-wide config registers a
    "Microsoft Visual Studio\Shared\NuGetPackages" fallback folder that does not exist on this
    setup, which causes restore to fail with NU1301. Clearing it here keeps restore self-contained.
  -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
